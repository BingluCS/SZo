//
// DO NOT MODIFY version.hpp, it is automatically generated by cmake
// Change the version numbers in CMakeLists.txt
//

#ifndef SZo_VERSION_HPP
#define SZo_VERSION_HPP
#include <sstream>

#define SZo_MAGIC_NUMBER 0xF342F310

#define SZo_NAME "@PROJECT_NAME@"
#define SZo_VER  "@PROJECT_VERSION@"
#define SZo_VER_MAJOR @PROJECT_VERSION_MAJOR@
#define SZo_VER_MINOR @PROJECT_VERSION_MINOR@
#define SZo_VER_PATCH @PROJECT_VERSION_PATCH@
#define SZo_VER_TWEAK @PROJECT_VERSION_TWEAK@

#define SZo_DATA_VER "@SZo_DATA_VERSION@"

inline uint32_t versionInt(const std::string& version) {
    uint32_t major = 0, minor = 0, patch = 0;
    char dot;
    std::stringstream ss(version);
    ss >> major >> dot >> minor >> dot >> patch;
    return (major << 24) | (minor << 16) | (patch<<8);
}

inline std::string versionStr(uint32_t version) {
    uint32_t major = (version >> 24) & 0xFF;
    uint32_t minor = (version >> 16) & 0xFF;
    uint32_t patch = (version >> 8) & 0xFF;
    return std::to_string(major) + "." + std::to_string(minor) + "." + std::to_string(patch);
}

#endif //SZo_VERSION_HPP
